{#
/**
 * @file
 * Theme override for the site branding block.
 *
 * The site name is printed one word per line ("TRIDI / CAPAS"), as in the
 * design.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}
{% extends "block.html.twig" %}
{% block content %}
  <a href="{{ path('<front>') }}" rel="home" class="site-branding" aria-label="{{ site_name ? site_name ~ ' - ' ~ 'Inicio'|t : 'Inicio'|t }}">
    {% if site_logo %}
      <span class="site-branding__logo">
        <img src="{{ site_logo }}" alt="" width="44" height="44" fetchpriority="high" />
      </span>
    {% endif %}
    {% if site_name or site_slogan %}
      <span class="site-branding__text">
        {% if site_name %}
          <span class="site-branding__name">
            {%- for word in site_name|render|striptags|trim|split(' ') -%}
              {{ word }}{% if not loop.last %}<br>{% endif %}
            {%- endfor -%}
          </span>
        {% endif %}
        {% if site_slogan %}
          <span class="site-branding__slogan">{{ site_slogan }}</span>
        {% endif %}
      </span>
    {% endif %}
  </a>
{% endblock %}
