{# Portada · Nosotros. #}
<section class="about" id="nosotros">
  <div class="container about__inner">
    <div class="about__text">
      <span class="eyebrow eyebrow--light">{{ '¿Quiénes somos?'|t }}</span>
      <h2>{{ 'Somos Tridi.'|t }}</h2>
      <p class="about__lead">
        {{ 'Podemos hacer realidad tus ideas.'|t }}<br>
        {{ 'Diseñamos y producimos piezas únicas'|t }}<br>
        {{ 'con impresión 3D pensando en vos.'|t }}
      </p>
      <ul class="about__list">
        <li>
          <span class="round-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <span>{{ 'Estamos en'|t }} <strong>{{ 'Paraná, Entre Ríos.'|t }}</strong></span>
        </li>
        <li>
          <span class="round-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg></span>
          <span>{{ 'Hacemos'|t }} <strong>{{ 'envíos a todo el país.'|t }}</strong></span>
        </li>
        <li>
          <span class="round-icon round-icon--yellow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.3 1.1 6.1L12 17l-5.4 2.8 1.1-6.1L3.2 9.4l6.1-.8Z"/></svg></span>
          <span><strong>{{ 'Materiales de calidad y terminaciones cuidadas.'|t }}</strong></span>
        </li>
        <li>
          <span class="round-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4Z"/><path d="M9 10h.01M12 10h.01M15 10h.01" stroke-width="2.5"/></svg></span>
          <span><strong>{{ 'Atención personalizada'|t }}</strong><br>{{ 'de principio a fin.'|t }}</span>
        </li>
      </ul>
    </div>

    <div class="about__media">
      {# Reemplazar por una foto real del taller (images/impresora.webp). #}
      <div class="about__blob">
        <img src="{{ base_path ~ directory }}/images/about-printer.svg" alt="{{ 'Impresora 3D imprimiendo un florero blanco'|t }}" width="520" height="400" loading="lazy">
      </div>
      <blockquote class="about__quote">
        <span class="quote-mark" aria-hidden="true">“</span>
        {{ 'Nos mueve la creatividad y las ganas de ayudarte a crear algo único.'|t }}
        <span class="quote-line" aria-hidden="true"></span>
      </blockquote>
    </div>
  </div>
</section>
