{#
  Portada · Cómo trabajamos / Contacto.

  El formulario es el webform "contacto" (ver tridi_preprocess_page()). Se
  administra en Estructura > Formularios; los emails se envían a la dirección
  del sitio.
#}
<section class="contact" id="como-trabajamos">
  <div class="container contact__inner">
    <div class="contact__text" id="contacto">
      <span class="eyebrow">{{ 'Contanos tu idea'|t }}</span>
      <h2>{{ 'Hablemos de'|t }} <span class="accent">{{ 'tu proyecto'|t }}</span></h2>
      <p>
        {{ 'Subí una imagen o boceto de tu idea, contanos qué necesitás y te respondemos a la brevedad con una propuesta.'|t }}
      </p>
      <ol class="steps">
        <li>
          <span class="feature-icon feature-icon--pink"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M5 20h14"/></svg></span>
          <span><strong>{{ 'Subí tu imagen'|t }}</strong>{{ 'o referencia'|t }}</span>
        </li>
        <li>
          <span class="feature-icon feature-icon--blue"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4Z"/><path d="M9 10h6"/></svg></span>
          <span><strong>{{ 'Contanos qué necesitás'|t }}</strong>{{ 'y para qué'|t }}</span>
        </li>
        <li>
          <span class="feature-icon feature-icon--yellow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3 3 10.5l7 2.5 2.5 7Z"/><path d="m10 13 4-4"/></svg></span>
          <span><strong>{{ 'Te respondemos'|t }}</strong>{{ 'rápido por Instagram'|t }}</span>
        </li>
      </ol>
    </div>

    {% if contact_form %}
      <div class="form-card contact-form">
        {{ contact_form }}
      </div>
    {% endif %}
  </div>
</section>
