<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the tridicapas theme.
 */

/**
 * Implements hook_page_attachments_alter().
 */
function tridi_page_attachments_alter(array &$attachments): void {
  // Preconnect to Google Fonts to load Plus Jakarta Sans faster.
  $attachments['#attached']['html_head_link'][] = [
    ['rel' => 'preconnect', 'href' => 'https://fonts.googleapis.com'],
  ];
  $attachments['#attached']['html_head_link'][] = [
    ['rel' => 'preconnect', 'href' => 'https://fonts.gstatic.com', 'crossorigin' => 'anonymous'],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for block--system-branding-block.html.twig.
 */
function tridi_preprocess_block__system_branding_block(array &$variables): void {
  // Static files are served with a very long browser cache lifetime, so the
  // logo's modification time is added to the URL as a version, making a new
  // logo show up without having to clear the browser cache.
  $logo = $variables['site_logo'] ?? '';
  if ($logo === '' || str_contains($logo, '?')) {
    return;
  }
  $path = DRUPAL_ROOT . '/' . ltrim(parse_url($logo, PHP_URL_PATH) ?? '', '/');
  if (is_file($path)) {
    $variables['site_logo'] = $logo . '?v=' . filemtime($path);
  }
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function tridi_preprocess_page(array &$variables): void {
  // Instagram account configured in Appearance > tridicapas.
  $instagram = trim((string) (theme_get_setting('instagram_user') ?? 'tridicapas'), " @/\t\n\r");
  $variables['instagram_user'] = $instagram;
  $variables['instagram_url'] = $instagram !== '' ? 'https://instagram.com/' . rawurlencode($instagram) : '';

  // "Contanos tu idea" form (webform "contacto") for the front page.
  if (!empty($variables['is_front'])) {
    $variables['contact_form'] = _tridi_webform_render('contacto');
  }
}

/**
 * Returns the render array of a webform, or an empty array if it is missing.
 */
function _tridi_webform_render(string $webform_id): array {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('webform')) {
    return [];
  }
  $webform = $entity_type_manager->getStorage('webform')->load($webform_id);
  if (!$webform || !$webform->access('submission_create')) {
    return [];
  }
  return $entity_type_manager->getViewBuilder('webform')->view($webform);
}
